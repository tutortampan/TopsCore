{
  // ─── DENO (Supabase Edge Functions only — isolated) ─────────────────
  "deno.enable": true,
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "broadcast-channel",
    "net",
    "kv"
  ],

  // ─── FILE ASSOCIATIONS ──────────────────────────────────────────────
  "files.associations": {
    "*.sql": "pgsql",
    "*.mjs": "javascript",
    "*.cjs": "javascript"
  },

  // ─── FORMATTING (Instant Save Optimization) ─────────────────────────
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "modifications",
  "editor.formatOnPaste": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[sql]": {
    "editor.formatOnSave": false
  },

  // ─── FIVE SERVER (Live Preview for TopsCore HTML/CSS/JS) ────────────
  "fiveServer.port": 5500,
  "fiveServer.openTerminal": false,
  "fiveServer.highlight": true,

  // ─── EDITOR UX ──────────────────────────────────────────────────────
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.colorDecorators": true,
  "workbench.editor.enablePreview": false,

  // ─── FILES & SEARCH EXCLUSIONS ──────────────────────────────────────
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "off",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/audit_screenshots/**": true,
    "**/scratch/**": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.supabase-cli": true,
    "**/scratch": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/audit_screenshots": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/scratch": true,
    "**/.git": true,
    "**/playwright-report": true
  },

  // ─── ERROR LENS (Precision Diagnostics) ──────────────────────────────
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.fontSize": "0.75rem",
  "errorLens.delay": 150,

  // ─── TERMINAL ───────────────────────────────────────────────────────
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.copyOnSelection": true,

  // ─── WINDOW & WORKSPACE OPTIMIZATIONS ─────────────────────────────
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "window.menuBarVisibility": "compact",
  "workbench.startupEditor": "none",
  "workbench.editor.closeOnFileDelete": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // ─── JAVASCRIPT & LANGUAGE PRODUCTIVITY ────────────────────────────
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.bracketPairs": true,

  // ─── GIT DISCIPLINE (Standing User Rule: No Auto Git Fetch/Commit) ──
  "git.autofetch": false,
  "git.confirmSync": true
}
