{
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "printWidth": 100,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.html"],
      "options": {
        "printWidth": 120,
        "tabWidth": 2,
        "parser": "html"
      }
    },
    {
      "files": ["*.css"],
      "options": {
        "tabWidth": 2,
        "singleQuote": false,
        "parser": "css"
      }
    },
    {
      "files": ["*.sql"],
      "options": {
        "tabWidth": 2,
        "parser": "sql"
      }
    },
    {
      "files": ["*.json"],
      "options": {
        "tabWidth": 2,
        "parser": "json"
      }
    }
  ]
}
