# TopsCore LMS — Environment Configuration Template
# For Netlify / Vercel Deployments, configure these environment variables in your project dashboard

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to true only if running against local Supabase CLI (127.0.0.1:54321)
USE_LOCAL=false

